/**
 * Modern Aesthetic Night Theme for Clipboard (Cliphist)
 * Designed for Hyprland / Rofi 1.7+
 **/

@import "colors.rasi"

/*****----- Configuration -----*****/
configuration {
    show-icons:                 true;
    drun-display-format:        "{name}";
    disable-history:            false;
    hover-select:               true;

    /* Vim navigation bindings (C-j: down, C-k: up) */
    kb-remove-to-eol:            "";
    kb-accept-entry:             "Control+m,Return,KP_Enter";
    kb-row-up:                   "Up,Control+k";
    kb-row-down:                 "Down,Control+n,Control+j";

    /* Custom actions */
    kb-custom-1:                 "Alt+Delete";
    kb-custom-2:                 "Control+p";
}

/*****----- Global Properties -----*****/
* {
    font:                        "JetBrainsMono Nerd Font 13";
    background-color:            transparent;
    text-color:                  var(fg);
    margin:                      0px;
    padding:                     0px;
    spacing:                     0px;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       62%;
    height:                      580px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     22px;
    border:                      2px solid;
    border-radius:               14px;
    border-color:                var(border-color);
    background-color:            var(bg);
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     14px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     10px 16px;
    border:                      1px solid;
    border-radius:               10px;
    border-color:                var(border-subtle);
    background-color:            var(bg-alt);
    text-color:                  var(fg);
    children:                    [ "prompt", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}

prompt {
    enabled:                     true;
    padding:                     6px 14px;
    border-radius:               8px;
    background-color:            var(accent);
    text-color:                  var(bg-solid);
    font:                        "JetBrainsMono Nerd Font Bold 12";
}

textbox-prompt-colon {
    enabled:                     false;
    expand:                      false;
    str:                         ":";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  var(fg);
    cursor:                      text;
    placeholder:                 "Search clipboard...";
    placeholder-color:           var(fg-muted);
    vertical-align:              0.5;
}

num-filtered-rows {
    enabled:                     true;
    expand:                      false;
    text-color:                  var(fg-muted);
    vertical-align:              0.5;
}

textbox-num-sep {
    enabled:                     true;
    expand:                      false;
    str:                         "/";
    text-color:                  var(fg-muted);
    vertical-align:              0.5;
}

num-rows {
    enabled:                     true;
    expand:                      false;
    text-color:                  var(fg-muted);
    vertical-align:              0.5;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     6px;
    margin:                      0px;
    padding:                     4px 0px 0px 0px;
    background-color:            transparent;
    text-color:                  var(fg);
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     14px;
    margin:                      0px;
    padding:                     8px 16px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  var(fg);
    cursor:                      pointer;
    border:                      0px;
    children:                    [ "element-icon", "element-text" ];
}

element normal.normal {
    background-color:            transparent;
    text-color:                  var(fg);
}

element normal.urgent {
    background-color:            var(urgent);
    text-color:                  var(bg-solid);
}

element normal.active {
    background-color:            var(bg-alt);
    text-color:                  var(accent);
}

element selected.normal {
    background-color:            var(bg-selected);
    text-color:                  var(accent);
    border:                      0px 0px 0px 4px;
    border-color:                var(accent);
}

element selected.urgent {
    background-color:            var(urgent);
    text-color:                  var(bg-solid);
}

element selected.active {
    background-color:            var(bg-selected);
    text-color:                  var(accent-mint);
    border:                      0px 0px 0px 4px;
    border-color:                var(accent-mint);
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  var(fg);
}

element alternate.urgent {
    background-color:            transparent;
    text-color:                  var(urgent);
}

element alternate.active {
    background-color:            transparent;
    text-color:                  var(accent);
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        40px;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    border-radius:               6px;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   bold #00ff99;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Message & Textbox -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     12px;
    border:                      1px solid;
    border-radius:               10px;
    border-color:                var(border-subtle);
    background-color:            var(bg-alt);
    text-color:                  var(fg);
}

textbox {
    background-color:            transparent;
    text-color:                  var(fg);
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

error-message {
    padding:                     20px;
    border:                      2px solid;
    border-radius:               14px;
    border-color:                var(urgent);
    background-color:            var(bg-solid);
    text-color:                  var(fg);
}
